{
  "name": "starter-workspace",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix frontend install && python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements-dev.txt",
    "db": "docker compose up -d mongo",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "cd backend && .venv/bin/pytest"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
